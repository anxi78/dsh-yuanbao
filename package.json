{
  "name": "@anxi78/dsh-yuanbao",
  "version": "0.2.1",
  "description": "Yuanbao IM channel plugin for deepseek-harness (dsh) — Anxi 定制分支：引用消息、媒体附件、Agent 工具、设置面板",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./client.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "client.js"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "yuanbao",
    "tencent",
    "im",
    "chatbot",
    "channel",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "protobufjs": "^7.5.4",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anxi78/dsh-yuanbao.git"
  },
  "homepage": "https://github.com/anxi78/dsh-yuanbao#readme",
  "bugs": {
    "url": "https://github.com/anxi78/dsh-yuanbao/issues"
  },
  "author": "anxi78",
  "publishConfig": {
    "access": "public"
  }
}